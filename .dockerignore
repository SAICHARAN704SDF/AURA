# Only the explicitly listed application sources enter the Docker build context.
**
!pyproject.toml
!backend
!backend/src
!backend/src/**
!frontend
!frontend/index.html
!frontend/app.js
!frontend/subjects.js
!frontend/styles.css
!apps
!apps/web
!apps/web/package.json
!apps/web/package-lock.json
!apps/web/next.config.mjs
!apps/web/tsconfig.json
!apps/web/postcss.config.mjs
!apps/web/scripts
!apps/web/scripts/editor-assets.mjs
!apps/web/src
!apps/web/src/**
!infrastructure
!infrastructure/docker
!infrastructure/docker/*.Dockerfile
!infrastructure/docker/api-entrypoint.sh
**/__pycache__
**/*.pyc
**/.env*
**/*.key
**/*.pem

!infrastructure/docker/Caddyfile
!infrastructure/docker/render-start.sh
